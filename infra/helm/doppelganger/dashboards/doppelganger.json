{
 "title": "Doppelganger",
 "uid": "doppelganger",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "doppelganger"
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(doppelganger_match_total, namespace)",
    "refresh": 2,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Match requests / s by outcome",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(doppelganger_match_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Match latency (p50 / p95)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(doppelganger_match_seconds_bucket{namespace=\"$namespace\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(doppelganger_match_seconds_bucket{namespace=\"$namespace\"}[1m])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Backend replicas (HPA)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\".*-backend\"}",
     "legendFormat": "available"
    },
    {
     "refId": "B",
     "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\"}",
     "legendFormat": "max"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Backend CPU per pod (cores)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"backend\"}[1m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "bargauge",
   "title": "Top-match strength distribution (calibrated)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (le) (increase(doppelganger_top_match_strength_bucket{namespace=\"$namespace\"}[$__range]))",
     "legendFormat": "{{le}}",
     "format": "heatmap"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "vertical",
    "displayMode": "basic"
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Backend memory per pod",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container=\"backend\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}